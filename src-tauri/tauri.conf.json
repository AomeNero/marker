{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Marker",
  "version": "../package.json",
  "identifier": "com.marker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:fe",
    "beforeBuildCommand": "npm run build:fe"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Marker",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGM0U4RjFGN0FDRTg0NUIKUldSYmhNNTZINDgrUDZlajRUZmppaDRKS3JYakIvOXZ4NlZqUURwWEhpZnJ4bC9iaGZkbktOWmUK",
      "endpoints": [
        "https://marker.aomenero.com/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "marker"
        ],
        "name": "Marker annotations",
        "description": "Marker 标注文件",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "./icons/installer-icon.ico",
        "sidebarImage": "./icons/installer-sidebar.bmp",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "wix": {
        "language": "zh-CN",
        "bannerPath": "./icons/installer-banner-blank.bmp",
        "dialogImagePath": "./icons/installer-dialog.bmp"
      }
    }
  }
}
